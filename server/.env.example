# ═══════════════════════════════════════════════════════════════════════
# BOWL BAE - Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS OR PRODUCTION PASSWORDS TO VERSION CONTROL
# ═══════════════════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=development

# MongoDB Connection String (use mongodb+srv:// with TLS for production Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/bowl_bae

# Security: JWT Secret for Admin Session Signing (min 32 random characters in production)
JWT_SECRET=super_secret_bowl_bae_jwt_key_change_in_production_32chars!

# Security: Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Admin Initial Seed Credentials (for initial setup only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BowlBae@Nagpur2026!Secure

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
