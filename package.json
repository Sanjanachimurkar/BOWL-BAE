{
  "name": "bowl-bae",
  "version": "1.0.0",
  "description": "Bowl Bae — Fresh Indian Salad Bowls (Garden Meets Tadka)",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
